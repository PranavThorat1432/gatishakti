# Copy to .env and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------
# If left unset, the app falls back to an in-memory mongomock store for
# local/demo use only (data does not persist across restarts).
MONGODB_URI=
MONGODB_DB=urban_intelligence

# --- CORS ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Multi-bus fusion (locked MVP parameters -- see README) -----------
DEFECT_CLUSTER_RADIUS_METERS=25
DEFECT_FUSION_WINDOW_MINUTES=30
DEFECT_MIN_UNIQUE_BUSES=2

# --- Cloudinary (optional -- degrades gracefully if unset) ------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OpenRouter (optional -- degrades gracefully if unset) ------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Computer vision (optional -- degrades gracefully if weights missing)
# See README "Selected pothole model" section before setting this.
POTHOLE_MODEL_PATH=ai/models/best.pt
AI_CONFIDENCE_THRESHOLD=0.50
